PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (Docker postgres_db container)
DATABASE_URL="postgresql://postgres:123@localhost:5432/transasia_db?schema=public"

# JWT Secrets
JWT_SECRET="transasia_super_secret_jwt_key_2026_production_change_me"
JWT_EXPIRES_IN="7d"

# Client CORS Origins
CLIENT_STOREFRONT_URL="http://localhost:3000"
CLIENT_ADMIN_URL="http://localhost:4000"

# OTP Settings (FR-42, FR-43)
OTP_MAX_RETRIES=3
OTP_LOCKOUT_HOURS=24
OTP_EXPIRY_MINUTES=5

# Middle DB Connection (TransAsia POS Middle DB)
MIDDLE_DB_HOST="localhost"
MIDDLE_DB_PORT=5432
MIDDLE_DB_NAME="transasia_middle_db"
MIDDLE_DB_USER="postgres"
MIDDLE_DB_PASSWORD="123"

# File Upload Path
UPLOAD_DIR="uploads"

# Direct POS MSSQL Database Connection
POS_DB_HOST="transasiadxb.ddns.net"
POS_DB_PORT=5050
POS_DB_NAME="softcodeTACSub"
POS_DB_USER="SCTACWeb"
POS_DB_PASSWORD="SoftTAC@1234#Web!"
